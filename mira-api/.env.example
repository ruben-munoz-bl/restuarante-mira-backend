NODE_ENV=development
PORT=3000
PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# FIRESTORE_EMULATOR_HOST=localhost:8080

# IA del agente (GEMINI_API_KEY obligatoria en producción)
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
AI_FALLBACK_MODEL=gemini-3.5-flash-lite
AI_MAX_TOKENS=350
AI_TEMPERATURE=0.7
# Tools del agente:"" = solo las 7 de fase 1 | "all" = todas | "getLedger,spinWheel" = concretas
AI_ENABLED_TOOLS=all

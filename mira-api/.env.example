NODE_ENV=development
PORT=3000
PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# FIRESTORE_EMULATOR_HOST=localhost:8080

# IA del agente (GEMINI_API_KEY obligatoria en producción)
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-3.5-flash
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.7
# Tools del agente:"" = solo las 7 de fase 1 | "all" = todas | "getLedger,spinWheel" = concretas
AI_ENABLED_TOOLS=all

# Trazabilidad (coleccion logs). Apagada por defecto; "true" para la presentacion.
LOGS_ENABLED=false
# Sal para el hash de la IP (pon un valor secreto en Render)
LOGS_IP_SALT=
# Tope de documentos de logs al dia (cada doc agrupa hasta 200 peticiones)
LOGS_MAX_DOCS_DIA=1000

# Auditoria (coleccion auditoria). Activa por defecto; el interruptor global vive en el panel (Ajustes).
# Tope de eventos reales al dia (protege la cuota gratuita de escrituras de Firestore)
AUDITORIA_MAX_DIA=8000
# Sal del hash de IP (si no, usa LOGS_IP_SALT)
AUDITORIA_IP_SALT=
# IPs propias a ignorar, separadas por comas
AUDITORIA_IPS_PROPIAS=
# Cada cuanto se piden a Firestore los eventos nuevos escritos por otros procesos (ms)
AUDITORIA_SYNC_MS=8000
